{
  "manifest_version": 3,
  "name": "PricePulse - Price History & Alert",
  "version": "1.1.0",
  "description": "Real-time product price tracking and price drop alerts across ecommerce platforms.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*",
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PricePulse Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*",
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*"
      ],
      "js": [
        "content/priceParser.js",
        "adapters/baseExtractor.js",
        "adapters/localTestExtractor.js",
        "adapters/amazonExtractor.js",
        "adapters/flipkartExtractor.js",
        "content/siteDetector.js",
        "content/productExtractor.js",
        "content/priceDetector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

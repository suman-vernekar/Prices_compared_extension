# ========================================================
# PricePulse Environment Variables (Template)
# Copy this file to .env before starting the backend
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/pricepulse
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pricepulse?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_pricepulse_dev_2026
JWT_EXPIRES_IN=7d

# Background Monitoring Configuration
MONITORING_CRON_INTERVAL="*/15 * * * *"
MONITOR_CONCURRENCY=5
PRICE_DROP_THRESHOLD_PERCENT=5

# Notification Settings (Optional / Week 7)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=PricePulse Alerts <alerts@pricepulse.io>

# Real-time SSE / Stream Settings
SSE_HEARTBEAT_INTERVAL_MS=30000
